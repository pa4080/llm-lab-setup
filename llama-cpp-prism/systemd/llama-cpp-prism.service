[Unit]
Description=llama.cpp Prism — Multi-model LLM inference server
After=network.target
Requires=network.target
Documentation=https://github.com/pa4080/llm-lab-setup/tree/master/llama-cpp-buun

[Service]
Type=simple
WorkingDirectory=/mnt/data/llm-lab/llama-cpp-prism
EnvironmentFile=/mnt/data/llm-lab/.env
ExecStart=/mnt/data/llm-lab/llama-cpp-prism/serve.sh
Restart=on-failure
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
