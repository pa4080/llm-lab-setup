# buun-llama-cpp source build (see buun-llama-cpp.cuda.Dockerfile)
# BUUN_CUDA_VERSION must be <= the host driver's max supported CUDA version
# (`nvidia-smi` reports it). BUUN_CUDA_DOCKER_ARCH is the CUDA compute capability
# to compile for (86 = RTX 3090 / sm_86).
BUUN_CUDA_VERSION=13.0.1
BUUN_CUDA_DOCKER_ARCH=86

# Service configuration (used by systemd service)
SERVICE_USER=pa4080
SERVICE_WORK_DIR=/mnt/data/llm-lab/llama-cpp-prism
