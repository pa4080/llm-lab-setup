PUBLIC_SERVER_NAME='LLaMA.cpp Public'
PUBLIC_URL='https://ai-lab...'
PUBLIC_API_KEY='${input:chat.lm.secret.-5b1abccd}'

LOCAL_SERVER_NAME='LLaMA.cpp Local'
LOCAL_URL='http://172.16.1.110:10005/v1/chat/completions'
